---
import ScrollReveal from "./motion/ScrollReveal";
import WorldMap from "./WorldMap.tsx";
---

<section id="locations" class="bg-white py-16 md:py-24 px-6 md:px-8">
  <div class="container-content">
    <ScrollReveal client:idle animation="fade-up">
      <p class="text-[11px] font-medium uppercase tracking-[3px] text-[#999] mb-4">OUR LOCATIONS</p>
      <h2 class="text-3xl font-light tracking-tight text-[#1A1A1A] md:text-5xl">Global presence.</h2>
    </ScrollReveal>
  </div>

  <!-- Harita geniş wrapper'da (container-content 1100'den taşar) → daha büyük -->
  <div class="mt-10 mx-auto w-full max-w-[1400px]">
    <WorldMap client:visible />
  </div>
</section>
