---
import ScrollReveal from "./motion/ScrollReveal";
import WorldMap from "./WorldMap.tsx";
import { OFFICES } from "../lib/offices";
---

<section id="locations" class="bg-white py-16 md:py-24 px-6 md:px-8">
  <div class="container-content">
    <ScrollReveal client:idle animation="fade-up">
      <p class="text-[11px] font-medium uppercase tracking-[3px] text-[#999] mb-4">OUR LOCATIONS</p>
      <h2 class="text-3xl font-light tracking-tight text-[#1A1A1A] md:text-5xl">Global presence.</h2>
    </ScrollReveal>
  </div>

  <!-- Harita geniş wrapper'da (container-content 1100'den taşar) → daha büyük -->
  <div class="mt-10 mx-auto w-full max-w-[1400px]">
    <WorldMap client:visible />
  </div>

  <!-- Adres kartları: haritadaki her pin için bir kart (tek kaynak: offices.ts). -->
  <div class="container-content mt-12 md:mt-16">
    <ScrollReveal client:idle animation="fade-up" delay={150}>
      <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4" aria-label="Office addresses">
        {OFFICES.map((office) => (
          <li class="border-t border-[#E5E7EB] pt-4">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-sm font-medium text-[#1A1A1A]">{office.city}</h3>
              <span class="text-[10px] font-medium uppercase tracking-[2px] text-[#999]">
                {office.type === "HQ" ? "Headquarters" : office.country}
              </span>
            </div>
            <address class="mt-2 text-[13px] not-italic leading-relaxed text-[#555]">
              {office.lines.map((line) => <span class="block">{line}</span>)}
            </address>
          </li>
        ))}
      </ul>
    </ScrollReveal>
  </div>
</section>
