---
// Dev-only motion library playground.
// Phase 0 Gate B kararı: v1'de Storybook yok, primitive demo'ları burada toplanır.
// Phase 1+ task'larında her primitive ekleyince bu sayfaya bir <section> eklenir.
//
// Codex P2 (Task 0.15): "_" prefix astro dev'de de 404 verdiği için kaldırıldı.
// Production erişimi runtime guard ile kapatılıyor.
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import BaseLayout from "../layouts/BaseLayout.astro";
import TradeRoute from "../components/motion/primitives/TradeRoute";
import SketchStroke from "../components/motion/primitives/SketchStroke";
---

<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Motion Library Playground (dev)</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        font-family: Inter, system-ui, sans-serif;
        padding: 40px;
        background: #fafafa;
        color: #111;
        margin: 0;
        line-height: 1.5;
      }
      h1 {
        font-weight: 300;
        font-size: 2rem;
        margin: 0 0 8px;
      }
      .meta {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 32px;
      }
      .demo {
        padding: 24px;
        border: 1px solid #e5e7eb;
        margin-bottom: 16px;
        background: #fff;
        border-radius: 6px;
      }
      .demo h2 {
        font-weight: 500;
        font-size: 1rem;
        margin: 0 0 12px;
        letter-spacing: -0.01em;
      }
      .empty {
        color: #9ca3af;
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <h1>Motion Library Playground</h1>
    <p class="meta">
      Dev-only sayfa — production build'e dahil değildir (Astro <code>_</code> prefix kuralı).
      Primitive'ler Phase 1-5'te eklendikçe buraya birer demo bloğu olarak gelir.
    </p>

    <section class="demo">
      <h2>TradeRoute — default (viewport-once)</h2>
      <div style="width: 400px; color: #111;">
        <TradeRoute client:load from={{ x: 20, y: 80 }} to={{ x: 180, y: 20 }} ariaLabel="Demo trade route" />
      </div>
    </section>

    <section class="demo">
      <h2>TradeRoute — yüksek curve</h2>
      <div style="width: 400px; color: #2563eb;">
        <TradeRoute client:load from={{ x: 20, y: 80 }} to={{ x: 180, y: 20 }} curve={0.8} />
      </div>
    </section>

    <section class="demo">
      <h2>TradeRoute — manual trigger</h2>
      <div style="width: 400px; color: #16a34a;">
        <TradeRoute client:load from={{ x: 20, y: 80 }} to={{ x: 180, y: 20 }} trigger="manual" id="demo-route" />
      </div>
      <button
        type="button"
        onclick="window.__motionTrigger && window.__motionTrigger('demo-route')"
        style="margin-top: 8px; padding: 6px 12px; cursor: pointer;"
      >
        Trigger
      </button>
    </section>

    <section class="demo">
      <h2>SketchStroke — circle (default)</h2>
      <div style="width: 240px; color: #111;">
        <SketchStroke client:load />
      </div>
    </section>

    <section class="demo">
      <h2>SketchStroke — ring</h2>
      <div style="width: 240px; color: #2563eb;">
        <SketchStroke client:load shape="ring" />
      </div>
    </section>

    <section class="demo">
      <h2>SketchStroke — arrow</h2>
      <div style="width: 240px; color: #16a34a;">
        <SketchStroke client:load shape="arrow" />
      </div>
    </section>

    <section class="demo">
      <h2>SketchStroke — custom (üçgen)</h2>
      <div style="width: 240px; color: #db2777;">
        <SketchStroke client:load shape="custom" path="M 10 80 L 60 20 L 110 80 Z" durationMs={1500} />
      </div>
    </section>
  </body>
</html>
