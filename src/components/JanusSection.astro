---
import ScrollReveal from "./motion/ScrollReveal";
import OntologyGraph from "./motion/primitives/OntologyGraph";
import TickCounter from "./motion/primitives/TickCounter";

// Janus — PlatcoX'in ihracat operasyon platformu.
const janusFlow = {
  nodes: [
    { id: "src", x: 18, y: 55, label: "Sevkiyat", weight: 1 },
    { id: "inv", x: 65, y: 35, label: "Fatura" },
    { id: "doc", x: 112, y: 55, label: "Belge" },
    { id: "sub", x: 159, y: 35, label: "Gönderim", weight: 1 },
    { id: "adv", x: 88, y: 90, label: "Uzman" },
  ],
  edges: [
    { from: "src", to: "inv" },
    { from: "inv", to: "doc" },
    { from: "doc", to: "sub" },
    { from: "inv", to: "adv" },
    { from: "doc", to: "adv" },
  ],
};
---

<section id="janus" class="section-padding bg-zinc-50/50">
  <div class="container-content">
    <ScrollReveal client:idle animation="fade-up">
      <p class="section-label">EXPORT AUTOMATION</p>
      <h2 class="text-3xl font-light tracking-tight md:text-5xl">
        Janus
      </h2>
      <p class="mt-6 max-w-2xl text-muted">
        İhracatı klavye işinden kurtaran operasyon platformu. Sevkiyat
        hazırlığından gönderim onayına kadar tüm akışı yönetir; karmaşık
        durumlarda kararı uzman incelemeye taşır.
      </p>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={100}>
      <div class="mt-12 mx-auto max-w-3xl" style="color: #1A1A1A;">
        <OntologyGraph
          client:idle
          nodes={janusFlow.nodes}
          edges={janusFlow.edges}
          alwaysShowLabels={true}
          ariaLabel="Janus akışı: Sevkiyat, Fatura, Belge, Gönderim, Uzman incelemesi"
          className="h-56 w-full"
        />
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={200}>
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            Belge / sevkiyat
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={47} suffix="+" durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            Fatura, gümrük beyanı, transit ve ekler — hepsi tek akışta.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            Manuel iş yükü
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={0.94} format="percent" precision={0} durationMs={2400} />
            <span class="text-base text-muted ml-2">azaltıldı</span>
          </p>
          <p class="mt-1 text-sm text-muted">
            Klavye dokunuşu yerine doğrulanmış otomasyon.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            İşlem geçmişi
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={1428} durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            Her karar kalıcı kayıtla — sonradan geri izlenebilir.
          </p>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
