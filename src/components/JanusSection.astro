---
import ScrollReveal from "./motion/ScrollReveal";
import TickCounter from "./motion/primitives/TickCounter";

// Janus pipeline — sevkiyat'tan gönderime tüm akış + uzman incelemesi.
// Custom inline SVG (OntologyGraph yerine) — daha zengin görsel: halo,
// flowing edges, gradient fill, breathing pulse.
const nodes = [
  { id: "src", x: 80, y: 130, label: "Shipment", step: "01" },
  { id: "inv", x: 250, y: 80, label: "Invoice", step: "02" },
  { id: "doc", x: 420, y: 130, label: "Documents", step: "03" },
  { id: "sub", x: 590, y: 80, label: "Submission", step: "04" },
  { id: "adv", x: 335, y: 230, label: "Expert review", step: "★" },
];

const edges: Array<{ from: string; to: string; via?: "primary" | "advisor" }> = [
  { from: "src", to: "inv", via: "primary" },
  { from: "inv", to: "doc", via: "primary" },
  { from: "doc", to: "sub", via: "primary" },
  { from: "inv", to: "adv", via: "advisor" },
  { from: "doc", to: "adv", via: "advisor" },
];

const byId = new Map(nodes.map((n) => [n.id, n]));
---

<section id="janus" class="section-padding bg-zinc-50/50">
  <div class="container-content">
    <ScrollReveal client:idle animation="fade-up">
      <p class="section-label">EXPORT AUTOMATION</p>
      <h2 class="text-3xl font-light tracking-tight md:text-5xl">
        Janus
      </h2>
      <p class="mt-6 max-w-2xl text-muted">
        The operations platform that takes export off the keyboard. It runs the
        whole flow — from shipment prep to submission approval — and escalates
        complex cases to expert review.
      </p>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={100}>
      <div class="janus-gap">
        <svg
          viewBox="0 0 670 320"
          class="janus-graph w-full max-w-4xl mx-auto"
          role="img"
          aria-label="Janus flow: Shipment, Invoice, Documents, Submission, Expert review"
        >
          <defs>
            <linearGradient id="janus-edge-primary" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#22C55E" stop-opacity="0.15" />
              <stop offset="50%" stop-color="#22C55E" stop-opacity="0.7" />
              <stop offset="100%" stop-color="#22C55E" stop-opacity="0.15" />
            </linearGradient>
            <linearGradient id="janus-edge-advisor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1A1A1A" stop-opacity="0.4" />
              <stop offset="100%" stop-color="#1A1A1A" stop-opacity="0.05" />
            </linearGradient>
            <radialGradient id="janus-node-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0%" stop-color="#22C55E" stop-opacity="0.45" />
              <stop offset="60%" stop-color="#22C55E" stop-opacity="0.1" />
              <stop offset="100%" stop-color="#22C55E" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="janus-advisor-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0%" stop-color="#1A1A1A" stop-opacity="0.25" />
              <stop offset="100%" stop-color="#1A1A1A" stop-opacity="0" />
            </radialGradient>
            <pattern id="janus-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1A1A1A" stroke-opacity="0.04" stroke-width="0.6" />
            </pattern>
          </defs>

          {/* Grid backdrop */}
          <rect width="670" height="320" fill="url(#janus-grid)" />

          {/* Edges */}
          {edges.map((e, i) => {
            const from = byId.get(e.from)!;
            const to = byId.get(e.to)!;
            const cx = (from.x + to.x) / 2;
            const cy =
              e.via === "advisor"
                ? Math.max(from.y, to.y) + 40
                : Math.min(from.y, to.y) - Math.abs(to.x - from.x) * 0.15;
            const d = `M ${from.x} ${from.y} Q ${cx} ${cy} ${to.x} ${to.y}`;
            const stroke =
              e.via === "advisor"
                ? "url(#janus-edge-advisor)"
                : "url(#janus-edge-primary)";
            return (
              <g>
                {/* Soft underlay */}
                <path d={d} fill="none" stroke={stroke} stroke-width="3" stroke-opacity="0.35" />
                {/* Flowing dashed top line */}
                <path
                  d={d}
                  fill="none"
                  stroke={e.via === "advisor" ? "#1A1A1A" : "#22C55E"}
                  stroke-opacity={e.via === "advisor" ? 0.35 : 0.85}
                  stroke-width="1.4"
                  stroke-dasharray="6 6"
                  class="janus-edge-flow"
                  style={`animation-delay: ${i * 0.35}s;`}
                />
              </g>
            );
          })}

          {/* Nodes */}
          {nodes.map((n) => {
            const isAdvisor = n.id === "adv";
            return (
              <g transform={`translate(${n.x}, ${n.y})`}>
                {/* Outer halo glow */}
                <circle
                  r="28"
                  fill={isAdvisor ? "url(#janus-advisor-glow)" : "url(#janus-node-glow)"}
                  class="janus-node-halo"
                />
                {/* Outer ring (pulse) */}
                <circle
                  r="14"
                  fill="none"
                  stroke={isAdvisor ? "#1A1A1A" : "#22C55E"}
                  stroke-opacity={isAdvisor ? 0.35 : 0.55}
                  stroke-width="1"
                  class="janus-node-pulse"
                />
                {/* Inner core */}
                <circle
                  r="7"
                  fill={isAdvisor ? "#1A1A1A" : "#22C55E"}
                />
                {/* Step badge */}
                <text
                  y="-32"
                  text-anchor="middle"
                  font-size="9"
                  font-weight="600"
                  fill={isAdvisor ? "#1A1A1A" : "#22C55E"}
                  letter-spacing="0.2em"
                >
                  {n.step}
                </text>
                {/* Label */}
                <text
                  y="34"
                  text-anchor="middle"
                  font-size="13"
                  font-weight="500"
                  fill="#1A1A1A"
                >
                  {n.label}
                </text>
              </g>
            );
          })}
        </svg>
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={200}>
      <div class="janus-gap grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            Documents / shipment
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={47} suffix="+" durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            Invoice, customs declaration, transit and attachments — all in one flow.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            Manual workload
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={0.94} format="percent" precision={0} durationMs={2400} />
            <span class="text-base text-muted ml-2">reduced</span>
          </p>
          <p class="mt-1 text-sm text-muted">
            Verified automation instead of keystrokes.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            Audit trail
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={1428} durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            Every decision is permanently logged — traceable after the fact.
          </p>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>

<style>
  /* Tek slide bütçesi: bölüm, sabit header düşülmüş ekran alanına sığmalı.
     Şema kalan boşluğa göre daralır (34rem = başlık + kartlar + boşluklar),
     11rem alt sınırı düğüm etiketlerini okunur tutar.

     Sığdırma yalnızca 900px+ genişlik ve 700px+ yükseklikte denenir. Bu
     sınırların dışında (alçak ekran, yüksek tarayıcı zoom'u, ya da 768-899px
     dar masaüstünde metnin fazladan satıra sarması) içerik hiçbir küçültmeyle
     sığmıyor; sığdırmayı zorlamak bölümü pager'ın "uzun" eşiğinin altında
     tutup alt kartları ulaşılamaz kılıyordu (Codex P2 ×2). Sınır dışında
     bölüm doğal boyuna döner ve kartlar intra-step ile erişilir. */
  .janus-gap {
    margin-top: 4rem;
  }

  @media (min-width: 900px) and (min-height: 700px) {
    .janus-gap {
      margin-top: clamp(1rem, 3svh, 2.5rem);
    }

    .janus-graph {
      max-height: min(26rem, max(11rem, calc(100svh - 34rem)));
    }
  }

  /* Edge dash flow */
  @keyframes janus-flow {
    to {
      stroke-dashoffset: -120;
    }
  }
  .janus-edge-flow {
    animation: janus-flow 6s linear infinite;
  }

  /* Outer ring pulse */
  @keyframes janus-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.25;
    }
  }
  .janus-node-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: janus-pulse 3s ease-in-out infinite;
  }

  /* Halo subtle breath */
  @keyframes janus-halo {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
  .janus-node-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: janus-halo 4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .janus-edge-flow,
    .janus-node-pulse,
    .janus-node-halo {
      animation: none;
    }
  }
</style>
