---
import ScrollReveal from "./motion/ScrollReveal";
import OntologyGraph from "./motion/primitives/OntologyGraph";
import TickCounter from "./motion/primitives/TickCounter";
import SketchStroke from "./motion/primitives/SketchStroke";

// Janusz — PlatcoX'in ana platform ürünü: ihracat otomasyon agentic platform.
// Source → Invoice → Document → Submit ardışık agent pipeline; karmaşık
// kararlarda Opus Advisor devreye girer (L4 autonomy + audit trail).
const januszFlow = {
  nodes: [
    { id: "src", x: 18, y: 55, label: "Source", weight: 1 },
    { id: "inv", x: 65, y: 35, label: "Invoice" },
    { id: "doc", x: 112, y: 55, label: "Document" },
    { id: "sub", x: 159, y: 35, label: "Submit", weight: 1 },
    { id: "adv", x: 88, y: 90, label: "Advisor (Opus)" },
  ],
  edges: [
    { from: "src", to: "inv" },
    { from: "inv", to: "doc" },
    { from: "doc", to: "sub" },
    { from: "inv", to: "adv" },
    { from: "doc", to: "adv" },
  ],
};
---

<section id="janusz" class="section-padding bg-zinc-50/50">
  <div class="container-content">
    <ScrollReveal client:idle animation="fade-up">
      <div class="flex flex-col md:flex-row justify-between items-end gap-8">
        <div class="max-w-2xl">
          <p class="section-label">EXPORT AUTOMATION PLATFORM</p>
          <h2 class="text-3xl font-light tracking-tight md:text-5xl">
            Janusz — kapıların tanrısı.
          </h2>
          <p class="mt-6 text-muted">
            İhracat e-Faturası, gümrük beyanı ve transit belgelerini sevkiyat'tan
            submission'a kadar yöneten agentic platform. Source → Invoice →
            Document → Submit ardışık pipeline; karmaşık kararlarda Opus
            Trade Advisor devreye girer. L4 autonomy, append-only audit trail,
            pydantic-validated agent contract'ları.
          </p>
        </div>
        <div class="flex items-center gap-3 text-accent">
          <div class="h-10 w-10">
            <SketchStroke client:idle shape="ring" durationMs={1500} />
          </div>
          <span class="text-xs uppercase tracking-[2px] text-muted">L4 autonomy</span>
        </div>
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={100}>
      <div class="mt-12 mx-auto max-w-3xl" style="color: #1A1A1A;">
        <OntologyGraph
          client:idle
          nodes={januszFlow.nodes}
          edges={januszFlow.edges}
          alwaysShowLabels={true}
          ariaLabel="Janusz pipeline: Source, Invoice, Document, Submit, with Opus Advisor"
          className="h-56 w-full"
        />
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle animation="fade-up" delay={200}>
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            DOCUMENTS / SHIPMENT
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={47} suffix="+" durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            e-Fatura, gümrük beyanı, transit, attachments — tek pipeline.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            MANUAL TOUCHPOINTS
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={0.94} format="percent" precision={0} durationMs={2400} />
            <span class="text-base text-muted ml-2">azaltıldı</span>
          </p>
          <p class="mt-1 text-sm text-muted">
            Manuel klavye dokunuşu yerine agent + escalation queue.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <p class="text-[11px] font-medium uppercase tracking-[2px] text-muted">
            AUDIT TRAIL EVENTS
          </p>
          <p class="mt-3 text-3xl font-light text-foreground">
            <TickCounter client:load target={1428} durationMs={2400} />
          </p>
          <p class="mt-1 text-sm text-muted">
            Her karar append-only DecisionRecord — retrospective kıyaslama.
          </p>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
